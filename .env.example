# FINeCIM (www.finecim.cz) login used by `python -m src.cli finecim ...`.
# Copy this file to .env (in the repo root, git-ignored) and fill in your own account,
# or - preferred - put the same two lines into ~/.finecim.env (outside the repository).
# Environment variables of the same name win over both files; FINECIM_ENV_FILE=<path>
# points to any other file. Never commit real values.
FINECIM_USERNAME=
FINECIM_PASSWORD=
